&lt;li&gt;Show compiling status alongside DevTools issues: &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5847094137&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vercel/next.js/issues/100178&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vercel/next.js/pull/100178/hovercard&quot; href=&quot;https://github.com/vercel/next.js/pull/100178&quot;&gt;#100178&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Pass staged fallback params into App rendering: &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5928263721&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vercel/next.js/issues/100408&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vercel/next.js/pull/100408/hovercard&quot; href=&quot;https://github.com/vercel/next.js/pull/100408&quot;&gt;#100408&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Capture initial HMR version in dev render context: &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5928262972&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vercel/next.js/issues/100407&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vercel/next.js/pull/100407/hovercard&quot; href=&quot;https://github.com/vercel/next.js/pull/100407&quot;&gt;#100407&lt;/a&gt;&lt;/li&gt;
