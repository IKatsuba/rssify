    <title>v16.5.0-canary.21</title>
    <content type="html">&lt;h3&gt;Core Changes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Defer app router HMR refresh until the router is initialized: &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5827140411&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vercel/next.js/issues/100113&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vercel/next.js/pull/100113/hovercard&quot; href=&quot;https://github.com/vercel/next.js/pull/100113&quot;&gt;#100113&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Misc Changes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;test: extend webpack timeout for dynamic-params-retained-cache: &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5919922717&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vercel/next.js/issues/100382&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vercel/next.js/pull/100382/hovercard&quot; href=&quot;https://github.com/vercel/next.js/pull/100382&quot;&gt;#100382&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Credits&lt;/h3&gt;
