    <title>v16.5.0-canary.20</title>
    <content type="html">&lt;h3&gt;Core Changes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Upgrade React from &lt;code&gt;ba39b32a-20261019&lt;/code&gt; to &lt;code&gt;a6792708-20261019&lt;/code&gt;: &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5945656025&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vercel/next.js/issues/100459&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vercel/next.js/pull/100459/hovercard&quot; href=&quot;https://github.com/vercel/next.js/pull/100459&quot;&gt;#100459&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Pass request headers explicitly into App request stores: &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5890902904&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vercel/next.js/issues/100333&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vercel/next.js/pull/100333/hovercard&quot; href=&quot;https://github.com/vercel/next.js/pull/100333&quot;&gt;#100333&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Remove request from App page prerender entry point: &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5890108600&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vercel/next.js/issues/100331&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vercel/next.js/pull/100331/hovercard&quot; href=&quot;https://github.com/vercel/next.js/pull/100331&quot;&gt;#100331&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Use render lifecycle callback for fetch metrics cleanup: &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5888094860&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vercel/next.js/issues/100323&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vercel/next.js/pull/100323/hovercard&quot; href=&quot;https://github.com/vercel/next.js/pull/100323&quot;&gt;#100323&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Upgrade React from &lt;code&gt;99c106c4-20261014&lt;/code&gt; to &lt;code&gt;ba39b32a-20261019&lt;/code&gt;: &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5927893855&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vercel/next.js/issues/100403&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vercel/next.js/pull/100403/hovercard&quot; href=&quot;https://github.com/vercel/next.js/pull/100403&quot;&gt;#100403&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Pass interception capability into App rendering: &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5928264397&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vercel/next.js/issues/100409&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vercel/next.js/pull/100409/hovercard&quot; href=&quot;https://github.com/vercel/next.js/pull/100409&quot;&gt;#100409&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Misc Changes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;[cd] Gate release bot credentials behind GitHub environments: &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5830083575&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vercel/next.js/issues/100121&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vercel/next.js/pull/100121/hovercard&quot; href=&quot;https://github.com/vercel/next.js/pull/100121&quot;&gt;#100121&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;test: retry vercel deploy on transient pre-deployment network errors: &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5816552046&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vercel/next.js/issues/100070&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vercel/next.js/pull/100070/hovercard&quot; href=&quot;https://github.com/vercel/next.js/pull/100070&quot;&gt;#100070&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;turbo-tasks: batch schedule invalidated tasks and cell dependents: &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5942015814&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vercel/next.js/issues/100446&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vercel/next.js/pull/100446/hovercard&quot; href=&quot;https://github.com/vercel/next.js/pull/100446&quot;&gt;#100446&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;turbopack: use reverse postorder priority in compute_merged_modules: &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5938310741&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vercel/next.js/issues/100430&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vercel/next.js/pull/100430/hovercard&quot; href=&quot;https://github.com/vercel/next.js/pull/100430&quot;&gt;#100430&lt;/a&gt;&lt;/li&gt;
