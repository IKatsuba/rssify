{
  "name": "rssify",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "vercel-build": "prisma generate && if [ \"$VERCEL_ENV\" = production ] || [ \"$VERCEL_ENV\" = preview ]; then prisma migrate deploy; fi && next build",
    "test": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://rssify@localhost:54329/rssify_test} DATABASE_URL_UNPOOLED=${TEST_DATABASE_URL:-postgresql://rssify@localhost:54329/rssify_test} bunx prisma migrate deploy && DATABASE_URL=${TEST_DATABASE_URL:-postgresql://rssify@localhost:54329/rssify_test} DATABASE_URL_UNPOOLED=${TEST_DATABASE_URL:-postgresql://rssify@localhost:54329/rssify_test} bun test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/api-key": "1.7.12",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@rowanmanning/feed-parser": "2.1.5",
    "better-auth": "1.7.12",
    "cheerio": "1.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.2",
    "better-call": "1.4.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "pg-connection-string": "2.14.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
